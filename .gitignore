# ===== 密钥与环境变量 =====
# .env 里放着 DeepSeek / 硅基流动的 API Key，绝对不能进仓库
.env
.env.local
*.env

# 但 .env.example 是"模板"（只有变量名没有值），必须提交，给协作者看
!.env.example

# ===== Python 虚拟环境 =====
# 里面是几百 MB 的解释器和第三方包，每个人电脑上都不一样，不需要共享
.venv/
venv/
env/

# ===== Python 运行时垃圾 =====
# 字节码缓存，解释器自动生成，不需要管
__pycache__/
*.py[cod]
*.pyo

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 数据文件 =====
# 本地开发用的 SQLite 数据库（里面是测试数据，不该进仓库）
*.db
*.sqlite3

# Chroma 向量库的本地持久化目录
chroma_data/
data/uploads/

# ===== 前端依赖（如果以后用 js 工具链，先挡掉）=====
node_modules/
dist/

# ===== 编辑器与系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===== 日志 =====
*.log
logs/
